@@ -203,0 +209,3 @@ def compute_data_metrics(batch: DataProto, use_critic: bool = True) -> dict[str,
+        # Valid response tokens inserted by the retriever and excluded from policy loss.
+        "information_length/mean": torch.mean(information_length).detach().item(),
+        "information_length/max": torch.max(information_length).detach().item(),
@@ -223,0 +232,10 @@ def compute_data_metrics(batch: DataProto, use_critic: bool = True) -> dict[str,
