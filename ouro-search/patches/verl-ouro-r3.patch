@@ -119,0 +120,2 @@ def compute_data_metrics(batch: DataProto, use_critic: bool = True) -> dict[str,
+    valid_response_mask = batch.batch["attention_mask"][:, -max_response_length:].bool()
+    information_length = (valid_response_mask.sum(-1) - response_mask.sum(-1)).float()
@@ -163,0 +166 @@ def compute_data_metrics(batch: DataProto, use_critic: bool = True) -> dict[str,
+        "outcome/accuracy": score_mean,
@@ -189,0 +193,2 @@ def compute_data_metrics(batch: DataProto, use_critic: bool = True) -> dict[str,
+        "response_length/p50": torch.quantile(response_length, 0.50).detach().item(),
