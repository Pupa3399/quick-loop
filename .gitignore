# Workspace metadata
/.agents/
/.codex/

# Python environments and caches
/.venv/
**/.cache/
**/__pycache__/
*.py[cod]
*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.ray-tmp/
**/.coverage
**/htmlcov/

# Local configuration and experiment tracking
**/.env
**/.env.*
!**/.env.example
**/wandb/
*.log

# External datasets, generated data, model weights, and local checkpoints
/main/datasets/*
!/main/datasets/.gitkeep
/main/data/*
!/main/data/.gitkeep
/main/models/*
!/main/models/.gitkeep
/main/checkpoints/*
!/main/checkpoints/.gitkeep
/main/eval/*/results/
/main/tests/*/results/

# Large artifacts outside the standard local directories
*.ckpt
*.safetensors
*.bin
*.pt
*.pth
*.faiss

# Editor and OS files
**/.idea/
**/.vscode/
*.swp
*.swo
.DS_Store
