+        metrics["search/action_rate"] = (num_search_turns > 0).mean()
+
+    if "format_valid" in batch.non_tensor_batch:
+        metrics["outcome/format_valid_rate"] = batch.non_tensor_batch[
+            "format_valid"
+        ].astype(float).mean()
+
